# Environment variables for AI Document Intelligence Backend

# Server settings
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Google Gemini Agent Platform Express Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Storage (optional — set SUPABASE_ENABLED=false to skip)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_NAME=documents
SUPABASE_ENABLED=true

# Supabase S3-compatible storage settings
SUPABASE_S3_ENDPOINT=https://ewmanzzpjjdzveuciuur.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=