# Environment variables for AI Document Intelligence Backend

# Server settings
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Google Gemini Agent Platform Express Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash